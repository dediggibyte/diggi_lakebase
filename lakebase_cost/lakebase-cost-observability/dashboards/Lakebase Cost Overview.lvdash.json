{
  "datasets": [
    {
      "name": "ds_daily_accum",
      "displayName": "Lakebase Daily Cost (Views)",
      "queryLines": [
        "SELECT workspace_name, usage_date, TRUNC(usage_date, 'MONTH') AS month, usage_unit, currency_code, database_instance_id, user, cost, accum_cost FROM databricks_lakebase.lakebase_cost.cost_lakebase_daily_accum where usage_date between '2025-06-15' and '2025-07-04'"
      ],
      "catalog": "databricks_lakebase",
      "schema": "lakebase_cost"
    },
    {
      "name": "ds_monthly_ws",
      "displayName": "Lakebase Monthly by Workspace",
      "queryLines": [
        "SELECT month, workspace_name, usage_unit, currency_code, monthly_cost, month_end_accum_cost FROM databricks_lakebase.lakebase_cost.cost_lakebase_by_workspace_monthly"
      ],
      "catalog": "databricks_lakebase",
      "schema": "lakebase_cost"
    },
    {
      "name": "ds_usage_detail",
      "displayName": "Lakebase Usage Detail (User/Instance)",
      "queryLines": [
        "SELECT CAST(usage_date AS DATE) AS usage_date, sku_name, usage_unit, database_instance_id, user, workspace_id, compute_qty FROM databricks_lakebase.lakebase_cost.usage_daily_user_instance"
      ],
      "catalog": "databricks_lakebase",
      "schema": "lakebase_cost"
    },
    {
      "name": "ds_rates",
      "displayName": "Lakebase Effective Rates",
      "queryLines": [
        "SELECT sku_name, usage_unit, currency_code, price_start_time, COALESCE(price_end_time, TIMESTAMP '2999-12-31') AS price_end_time, effective_rate FROM databricks_lakebase.lakebase_cost.effective_rates"
      ],
      "catalog": "databricks_lakebase",
      "schema": "lakebase_cost"
    },
    {
      "name": "ds_cost_ma7",
      "displayName": "Daily Cost vs 7D Moving Avg",
      "queryLines": [
        "WITH d AS (SELECT usage_date, usage_unit, SUM(cost) AS daily_cost FROM databricks_lakebase.lakebase_cost.cost_lakebase_daily_accum GROUP BY usage_date, usage_unit) SELECT  d.usage_date,  d.usage_unit,  d.daily_cost,  AVG(d.daily_cost) OVER (PARTITION BY d.usage_unit ORDER BY d.usage_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS ma7 FROM d"
      ],
      "catalog": "databricks_lakebase",
      "schema": "lakebase_cost"
    }
  ],
